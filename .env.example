# Neon (Postgres). Use the pooled URL for the app, the unpooled one for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin sign-in (the /admin area is locked until both are set)
ADMIN_PASSWORD=choose-a-long-passphrase
SESSION_SECRET=paste-a-long-random-string

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=Pet Shelter NG <onboarding@resend.dev>   # use your verified domain in production
STAFF_EMAIL=                                         # where staff alerts go

# Public settings
NEXT_PUBLIC_WHATSAPP=            # e.g. 2348000000000 (country code, no +)
NEXT_PUBLIC_GOFUNDME=            # Pet Shelter NG GoFundMe link
